# CRS 瀹㈡埛绔覆鏌撴湇鍔＄幆澧冨彉閲?
# API 鍩虹鍦板潃
VITE_API_BASE_URL=/api

# 搴旂敤鏍囬
VITE_APP_TITLE=CRS瀹㈡埛绔覆鏌撴湇鍔?
# 鏄惁鐢熶骇鐜
VITE_PROD=false

# 璋冭瘯妯″紡
VITE_DEBUG=true

# 鐗堟湰鍙?VITE_APP_VERSION=1.0.0
# CMS 管理端源（用于postMessage目标源）
VITE_POSTMESSAGE_PARENT_ORIGIN=http://127.0.0.1:3011
# postMessage 签名密钥：必须与 CMS 端配置同一值（跨 origin 无法共享 sessionStorage，
# 否则预览 iframe 会因验签失败渲染为空）
VITE_MESSAGE_SECRET=change-me-shared-between-cms-and-crs
# 轻量埋点开关：true/false
VITE_TRACKING_ENABLED=true

