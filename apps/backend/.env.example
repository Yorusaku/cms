# Server
PORT=3300
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=cms_platform

# JWT
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d

# File Upload
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_BASE_URL=http://127.0.0.1:3300/uploads

# Admin Seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# AI Provider (OpenAI-compatible)
# Examples:
# - DeepSeek: AI_BASE_URL=https://api.deepseek.com
# - Tongyi Qianwen compatible mode: AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MOCK_ENABLED=false
