# Server
PORT=3300
NODE_ENV=development
# 允许跨域的前端来源（逗号分隔）。未配置时使用本地 3010/3011
CORS_ORIGINS=http://127.0.0.1:3011,http://127.0.0.1:3010

# Database
# 生产环境（NODE_ENV=production）下这些项必须显式配置，不会回退到默认值
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=cms_platform_resume

# JWT
# 生产环境必须为随机值且不少于 32 位，否则拒绝启动
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d

# File Upload
# STORAGE_DRIVER=local 本地磁盘（开发/单机）；=s3 走 S3 兼容对象存储（生产）
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_BASE_URL=http://127.0.0.1:3300/uploads

# 对象存储（STORAGE_DRIVER=s3 时必填，参数缺失将导致启动失败）
# S3_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com
# S3_REGION=cn-shenzhen
# S3_BUCKET=cms-marketing-assets
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com/cms-assets
# S3_FORCE_PATH_STYLE=true

# Admin Seed
# SEED_ENABLED 未配置时：开发/测试默认开启，生产默认关闭
# 生产开启时只会创建管理员账号（演示账号/演示页/演示模板一律跳过）
SEED_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# Lead Data Governance
# 线索保留天数：超过该天数的线索可被管理员通过 purgeExpiredLeads 清理；默认 180
LEAD_RETENTION_DAYS=180

# AI Provider (OpenAI-compatible)
# Examples:
# - DeepSeek: AI_BASE_URL=https://api.deepseek.com
# - Tongyi Qianwen compatible mode: AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MOCK_ENABLED=false
