{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local", "pnpm-lock.yaml"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.{md,png,jpg,jpeg,gif,svg,webp,ico}", "!**/coverage/**"],
      "env": ["NODE_ENV", "VITE_*"],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.{md,png,jpg,jpeg,gif,svg,webp,ico}", "!**/coverage/**"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.{md,png,jpg,jpeg,gif,svg,webp,ico}", "!**/coverage/**"],
      "cache": true
    },
    "clean": {
      "cache": false
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/coverage/**"],
      "cache": true
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md", "!**/coverage/**"],
      "cache": true
    },
    "lint:fix": {
      "outputs": [],
      "cache": false
    }
  }
}
